# ==============================================================================
# AgentWala OS - Environment Variables
# If ANY key is omitted, the app gracefully falls back to local mock mode
# and logs simulated actions into the activity_log table. Zero keys required to run!
# ==============================================================================

# Public URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Demo Form Webhook (e.g. Google Apps Script / Zapier / Make)
LEAD_WEBHOOK_URL=""

# Supabase (Optional: uses local mock database if not provided)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Razorpay (Optional: uses mock checkout links if not provided)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Meta WhatsApp Cloud API (Optional: logs messages to activity_log if not provided)
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WEBHOOK_VERIFY_TOKEN=""

# Resend Email (Optional: logs emails to activity_log if not provided)
RESEND_API_KEY=""
EMAIL_FROM="AgentWala <hello@agentwala.in>"

# Cal.com Webhooks (Optional)
CAL_WEBHOOK_SECRET=""

# AI Provider (Claude or Gemini via lib/ai.ts - Optional)
AI_API_KEY=""
AI_PROVIDER="gemini" # "gemini" | "anthropic"

