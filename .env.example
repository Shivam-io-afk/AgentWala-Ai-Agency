# ==============================================================================
# Agmeta OS - Environment Variables
# If ANY key is omitted, the app gracefully falls back to local mock mode
# and logs simulated actions into the activity_log table. Zero keys required to run!
# ==============================================================================

# Public URL (In production on Vercel, set this to your deployment domain, e.g. https://agent-wala-ai-agency.vercel.app)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin Authentication & Security
# AUTH_SECRET must be set to a secure random string (32+ chars) in production.
AUTH_SECRET="agmeta_dev_secret_key_884920492193"
# Comma-separated list of authorized founder email addresses allowed to log in
FOUNDER_EMAILS="shivam.mishra.cuh@gmail.com"
# Direct founder login fallback code (bypasses Resend email requirement; 32+ chars)
FOUNDER_LOGIN_CODE=""

# Demo Form Webhook (e.g. Google Apps Script / Zapier / Make)
LEAD_WEBHOOK_URL=""

# Supabase Persistence (Run supabase/app_state.sql in Supabase SQL editor)
# On Vercel, set these to persist leads, invoices, checklist, and OS state.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Razorpay (Optional: uses mock checkout links if not provided)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Meta WhatsApp Cloud API (Optional: logs messages to activity_log if not provided)
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WEBHOOK_VERIFY_TOKEN=""

# Resend Email (Optional: logs emails to mock outbox if not provided)
RESEND_API_KEY=""
EMAIL_FROM="Agmeta <shivam.mishra.cuh@gmail.com>"

# Cal.com Webhooks (Optional)
CAL_WEBHOOK_SECRET=""

# AI Provider (Claude or Gemini via lib/ai.ts - Optional)
AI_API_KEY=""
AI_PROVIDER="gemini" # "gemini" | "anthropic"
